# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging (created by editable installs and builds)
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/
.venv/

# Environment variables & secrets (CRITICAL: keeps API keys off GitHub)
.env
.env.*
!.env.example

# IDEs and editors
.vscode/
.idea/
*.swp
*.swo

# Testing & linting caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Data files (avoid committing large or changing local datasets)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Logs and SQLite databases
*.log
*.sqlite
*.sqlite3
*.db

# OS specific files
.DS_Store
Thumbs.db